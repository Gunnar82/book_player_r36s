FROM debian:bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential make libsdl2-dev libsdl2-mixer-dev libsdl2-ttf-dev \
    libcurl4-openssl-dev libsystemd-dev libqrencode-dev ca-certificates \
    pkg-config binutils libc-bin && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY *.c *.h ./
COPY Makefile.gpm2804 ./Makefile
COPY screens ./screens
RUN grep 'APP_VERSION "0.3.58"' config.h && \
    grep -q 'extern char download_base_url' storage.h && grep -q 'extern int display_timeout_seconds' state.h && \
    grep -q 'extern int menu_font_size' state.h && grep -q 'mpris_bridge_init' mpris_bridge.h && \
    grep -q 'media_feedback_show' media_feedback.h && grep -q 'media_capable' media_keys.h && \
    grep -q 'SCREEN_DOWNLOADS' screens.h && grep -q 'input_config_load' input_config.h && \
    grep -q 'input_normalize_event' input_config.h && test -f input_config.c && test -f input_config.h && \
    test -f download.c && test -f background_download.c && test -f background_download.h && \
    test -f background_download_ui.c && test -f mpris_bridge.c && test -f bluetooth.c && \
    test -f bluetooth_audio_sink.c && test -f batocera_bluetooth.c && test -f batocera_pair_agent.c && \
    test -f batocera_pair_agent.h && grep -q 'DisplayYesNo' batocera_pair_agent.c && test -f hfp_gateway.c && \
    test -f pbap_phonebook.c && test -f battery_bluez.c && grep -q 'org.bluez.Device1' bluetooth.c && \
    test -f screens/bluetooth.c && test -f screens/downloadsettings.c && test -f screens/streamsettings.c && \
    test -f media_feedback.c && test -f app_log.c && test -f screens/downloadbrowser.c && test -f screens/logview.c
RUN make clean && make
RUN readelf -h /build/hoerspiel_player | grep -E 'Class:|Machine:'
RUN mkdir -p /dist/lib && cp /build/hoerspiel_player /dist/hoerspiel_player
RUN ldd /build/hoerspiel_player | awk '/=> \// { print $3 } /^\// { print $1 }' | sort -u > /tmp/libs.txt && while read lib; do cp -L "$lib" /dist/lib/; done < /tmp/libs.txt
RUN cp -L /lib/ld-linux-aarch64.so.1 /dist/lib/ld-linux-aarch64.so.1
RUN cat > /dist/config.gpm2804.ini <<'EOF'
[input]
profile=custom
dpad_mode=axis
dpad_x_axis=0
dpad_y_axis=1
dpad_deadzone=16000

a=2
b=1
x=3
y=0

l1=4
r1=5
l2=-1
r2=-1

start=9
select=8
EOF
RUN echo "=== Binary ===" && readelf -h /dist/hoerspiel_player | grep -E 'Class:|Machine:' && echo "=== Libraries ===" && ls -lah /dist/lib && echo "=== Runtime dependencies ===" && ldd /dist/hoerspiel_player
RUN cat > /dist/hoerspiel.sh <<'EOF'
#!/bin/bash
APPDIR="$(cd "$(dirname "$0")" && pwd)"
cd "$APPDIR" || exit 1
if [ -d "$APPDIR/lib" ]; then
  export LD_LIBRARY_PATH="$APPDIR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
exec "$APPDIR/hoerspiel_player"
EOF
FROM scratch AS export
COPY --from=build /dist /
