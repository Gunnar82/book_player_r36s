# Hoerspiel Player
# Beliebig viele path= Eintraege sind moeglich.
# Nicht vorhandene Pfade werden beim Start einfach ignoriert.

[storage]
path=/roms/hoerspiele
path=/roms2/hoerspiele
path=/mnt/usbdrive/hoerspiele

[hardware]
# -1 = automatische Erkennung beim ersten Start
led_gpio=-1
led_gpio_mode=auto

[playback]
# 0 = am Ende stoppen, 1 = Hoerspiel von vorn beginnen
repeat_book=0

[download]
# Downloads sind standardmaessig deaktiviert.
enabled=0
# Basis-URL des nginx XML-Listings, http oder https.
base_url=
# Lokales Ziel fuer heruntergeladene Hoerspiele.
target_path=/roms/hoerspiele
# TLS-Pruefung sollte normalerweise aktiviert bleiben.
verify_peer=1
verify_host=1
# Optional: eigene CA und mTLS Client-Zertifikat/Key.
ca_cert=
client_cert=
client_key=
client_key_password=
