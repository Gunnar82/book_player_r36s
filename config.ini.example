# Hoerspiel Player
# Beliebig viele path= Eintraege sind moeglich.
# Nicht vorhandene Pfade werden beim Start einfach ignoriert.

[storage]
path=/roms/hoerspiele
path=/roms2/hoerspiele
path=/mnt/usbdrive/hoerspiele

[hardware]
# -1 = automatische Erkennung beim ersten Start
led_gpio=-1
led_gpio_mode=auto

[playback]
# 0 = am Ende stoppen, 1 = Hoerspiel von vorn beginnen
repeat_book=0
